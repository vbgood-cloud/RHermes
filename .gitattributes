# 统一换行符：仓库内一律 LF（防止 Windows 编辑器批量改写造成整库假 diff）
* text=auto eol=lf

# Windows 脚本保持 CRLF（cmd 解释器要求）
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制文件不做任何转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.exe binary
*.dll binary
*.pdf binary
*.zip binary
*.gz binary
*.xz binary
*.woff binary
*.woff2 binary
